# --- API ---
PORT=3000
# Mínimo 16 caracteres. Cambia estos valores fuera de desarrollo.
JWT_SECRET=dev-only-jwt-secret-change-me
JWT_EXPIRES_IN=15m
WEBHOOK_SECRET=dev-only-webhook-secret-change-me
CORS_ORIGIN=http://localhost:5173
# Crea el esquema y los usuarios de prueba al arrancar (true/false)
SEED_ON_START=true

# --- Base de datos ---
# Docker Compose (por defecto):
DATABASE_URL=postgres://orbita:orbita@localhost:5432/orbita
TEST_DATABASE_URL=postgres://orbita:orbita@localhost:5432/orbita_test
# Laragon / Postgres local (ejemplo):
# DATABASE_URL=postgres://postgres:TU_PASS@localhost:5432/orbita
# TEST_DATABASE_URL=postgres://postgres:TU_PASS@localhost:5432/orbita_test
